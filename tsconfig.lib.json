{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",

        // File Layout
        "rootDir": "src",
        "outDir": "dist",

        // Environment Settings
        "lib": ["dom", "dom.iterable", "esnext"],
        "moduleResolution": "bundler",

        // Emit
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
    },
    "include": ["src"],
}
